# Copy to .env for local development; manage.py loads it. Nothing is required
# for `runserver` with dev settings. These exist to override the defaults.

# Origins allowed to call the API with cookies (dev default: http://localhost:5500,http://127.0.0.1:5500)
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5500

# Where the SQLite file lives (default: backend/db.sqlite3)
# DB_PATH=/path/to/budget.sqlite3
